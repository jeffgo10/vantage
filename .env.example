# Local Supabase (default for `pnpm dev`)
# Start stack first: `pnpm db:start` then copy keys from `pnpm db:status -o env`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hosted Supabase (production / preview) — swap these when not using local:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Stripe (Phase 3 — stubs in src/lib/stripe.ts throw until wired)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email)
# RESEND_API_KEY=

# Sentry
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
